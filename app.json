{
  "expo": {
    "name": "ActiveCard",
    "slug": "activecard",
    "version": "1.10.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "activecard",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090B",
    "android": {
      "package": "com.marti.activecard",
      "adaptiveIcon": {
        "backgroundColor": "#09090B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marti.activecard",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "ActiveCard convierte tu voz en texto para el Gimnasio Mental.",
        "NSMicrophoneUsageDescription": "ActiveCard usa el micrófono para dictar tus conexiones de ideas."
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "baseUrl": "/activecard"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "@jamsch/expo-speech-recognition",
        {
          "microphonePermission": "ActiveCard usa el micrófono para dictar tus conexiones de ideas.",
          "speechRecognitionPermission": "ActiveCard convierte tu voz en texto para el Gimnasio Mental."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#3E63DD",
          "defaultChannel": "repaso-diario"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "targetCellWidth": 4,
              "label": "ActiveCard · Repaso diario",
              "resizeMode": "horizontal|vertical",
              "minHeight": "132dp",
              "updatePeriodMillis": 1800000,
              "targetCellHeight": 2,
              "description": "Pendientes y progreso del día. Tocá para repasar.",
              "minWidth": "250dp",
              "name": "DailyReview",
              "previewImage": "./assets/widgets/daily-preview.png"
            },
            {
              "targetCellWidth": 4,
              "label": "ActiveCard · Mazos",
              "resizeMode": "horizontal|vertical",
              "minHeight": "220dp",
              "updatePeriodMillis": 1800000,
              "targetCellHeight": 3,
              "description": "Continuá los mazos en progreso de hoy y abrí también tus recientes.",
              "minWidth": "250dp",
              "name": "StudyDecks",
              "previewImage": "./assets/widgets/decks-preview.png"
            },
            {
              "targetCellWidth": 4,
              "label": "ActiveCard · Repaso y mazos",
              "resizeMode": "horizontal|vertical",
              "minHeight": "340dp",
              "updatePeriodMillis": 1800000,
              "targetCellHeight": 3,
              "description": "Repaso con racha animada y mazos desplazables: progreso y recientes.",
              "minWidth": "250dp",
              "name": "ReviewAndDecks",
              "previewImage": "./assets/widgets/combined-preview.png"
            }
          ],
          "fonts": [
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/400Regular/PlusJakartaSans_400Regular.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/700Bold/PlusJakartaSans_700Bold.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/800ExtraBold/PlusJakartaSans_800ExtraBold.ttf"
          ]
        }
      ],
      "./plugins/with-widget-resize",
      "./plugins/with-widget-flame"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c0ae7728-da97-4e4c-ae55-c8a010375d8c"
      }
    },
    "owner": "vicentemartinluciano",
    "updates": {
      "url": "https://u.expo.dev/c0ae7728-da97-4e4c-ae55-c8a010375d8c"
    }
  }
}
