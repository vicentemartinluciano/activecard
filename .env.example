# Copiar este archivo como `.env` y completar con las claves reales.
# El `.env` real NUNCA se commitea (está en .gitignore).

# Conexión recomendada del APK: gateway propio que guarda la clave de OpenAI.
EXPO_PUBLIC_ACTIVECARD_AI_URL=https://tu-gateway.example.com/v1/responses
EXPO_PUBLIC_ACTIVECARD_AI_TOKEN=

# Solo para desarrollo local directo (no distribuir dentro de un APK).
EXPO_PUBLIC_OPENAI_API_KEY=sk-...

# Token de la integración interna de Notion (notion.so/my-integrations)
EXPO_PUBLIC_NOTION_TOKEN=ntn_...
