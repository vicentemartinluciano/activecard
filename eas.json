{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_OPENAI_API_KEY": "",
        "EXPO_PUBLIC_NOTION_TOKEN": "",
        "EXPO_PUBLIC_ANTHROPIC_API_KEY": ""
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_OPENAI_API_KEY": "",
        "EXPO_PUBLIC_NOTION_TOKEN": "",
        "EXPO_PUBLIC_ANTHROPIC_API_KEY": ""
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
